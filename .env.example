# Copy to .env and fill in. `.env` is gitignored; this example file is committed.
#
# Two groups below:
#   - App runtime      → loaded by src/server.js via dotenv when you run the app locally.
#   - Deployment        → read from your shell by scripts/deploy.sh. deploy.sh does NOT
#                         auto-load this file, so export these first, e.g.:
#                           set -a; source .env; set +a
#                         (CI runs use GitHub Actions secrets/variables, not this file.)

# ─── App runtime ────────────────────────────────────────────────────────────────────
# Port for the HTTP server (optional if server.js uses 3000 by default)
PORT=3000

# Required for x-api-key auth on /v1/weather/* (must match what clients send)
WEATHER_API_KEY=1234

# Optional: Node environment (e.g. test, development, production)
NODE_ENV=development

# ─── Deployment (scripts/deploy.sh → EKS) ───────────────────────────────────────────
# Postman API key used by the Insights agent. Must have WRITE access (workspace Admin or
# Super Admin) to the target workspace. When set, deploy.sh creates the agent secret and
# applies the Insights DaemonSet; when unset, the agent step is skipped. Leave blank to
# deploy the API without observability.
POSTMAN_INSIGHTS_API_KEY=PMAK-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional deploy.sh overrides — default to `terraform output` values when unset. Set only
# if you're deploying without the Terraform state handy (e.g. to a preexisting cluster).
# AWS region of the cluster/ECR repo
REGION=us-east-1
# EKS cluster name
CLUSTER_NAME=postair-weather-api
# ECR repository URL (registry-host/repo)
ECR_REPO=000000000000.dkr.ecr.us-east-1.amazonaws.com/postair-weather-api
# Image tag to build/deploy (defaults to current git short SHA, else "latest")
IMAGE_TAG=latest

# NOTE: the Insights workspace + system-environment UUIDs are NOT env vars — they live on
# the app Deployment (infra/k8s/deployment.yaml) as POSTMAN_INSIGHTS_WORKSPACE_ID /
# POSTMAN_INSIGHTS_SYSTEM_ENV, because the DaemonSet reads them per-pod. Edit them there.
